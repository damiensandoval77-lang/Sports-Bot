FROM python:3.12-slim
WORKDIR /app
COPY iphone_bot/__init__.py iphone_bot/__init__.py
COPY iphone_bot/capture_live_research.py iphone_bot/capture_live_research.py
COPY iphone_bot/publish_live_tracker_feed.py iphone_bot/publish_live_tracker_feed.py
COPY iphone_bot/live_tracker_service.py iphone_bot/live_tracker_service.py
ENV PORT=8080 LIVE_POLL_SECONDS=35 LIVE_CORS_ORIGIN=https://damiensandoval77-lang.github.io PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["python","-m","iphone_bot.live_tracker_service"]
