{
  "name": "dames-picks-cloudflare-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/worker.js && node --check scripts/build-assets.mjs && npm test && npm run build",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.68.0"
  }
}
