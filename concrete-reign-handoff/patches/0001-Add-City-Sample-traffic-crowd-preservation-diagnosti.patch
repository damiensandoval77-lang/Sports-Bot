+    "pedestrian": {"keywords": ["Crowd", "Pedestrian", "MassAgent"], "exclude": ["Spawner", "Subsystem", "Manager", "Visualizer"]},
+    "mass_spawner": {"keywords": ["MassSpawner", "Spawner"], "exclude": []},
+    "zonegraph": {"keywords": ["ZoneGraphData", "ZoneShape"], "exclude": []},
+    "mass_visualizer": {"keywords": ["MassVisualizer", "MassRepresentation", "Visualizer"], "exclude": []}
+  },
+  "asset_classes": {
