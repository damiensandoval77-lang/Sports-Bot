+"""Development performance presets as *runtime* console variables. Nothing is written to config.
+
+  python cr_perf_presets.py --emit medium        # print commands to paste into the ~ console
+  (Editor Python, during PIE)  import cr_perf_presets; cr_perf_presets.apply("low")
+
+Presets are starting points for an unknown GPU, not FPS promises. Measure with the
+`profile` commands on the real PC and record results in docs/claude/PERFORMANCE_STRATEGY.md.
+Only stock engine console variables are used; City Sample crowd/traffic density controls are
+sample-specific and must be identified locally (see the strategy doc) before being added here.
+"""
+import argparse
+
+# Scalability groups: 0 low, 1 medium, 2 high, 3 epic. Explicit cvars follow the group values.
+PRESETS = {
+    "low": [
+        "sg.ResolutionQuality 50", "sg.ViewDistanceQuality 1", "sg.AntiAliasingQuality 1",
+        "sg.ShadowQuality 1", "sg.GlobalIlluminationQuality 1", "sg.ReflectionQuality 1",
+        "sg.PostProcessQuality 1", "sg.TextureQuality 1", "sg.EffectsQuality 1",
+        "sg.FoliageQuality 1", "sg.ShadingQuality 1",
+        "r.ScreenPercentage 50", "r.AntiAliasingMethod 4",
+        "r.Lumen.HardwareRayTracing 0", "r.Shadow.Virtual.Enable 1",
+        "r.Nanite.MaxPixelsPerEdge 2", "r.Streaming.PoolSize 2000",
+        "r.VSync 0", "t.MaxFPS 60",
+    ],
+    "medium": [
+        "sg.ResolutionQuality 67", "sg.ViewDistanceQuality 2", "sg.AntiAliasingQuality 2",
+        "sg.ShadowQuality 2", "sg.GlobalIlluminationQuality 2", "sg.ReflectionQuality 2",
+        "sg.PostProcessQuality 2", "sg.TextureQuality 2", "sg.EffectsQuality 2",
+        "sg.FoliageQuality 2", "sg.ShadingQuality 2",
+        "r.ScreenPercentage 67", "r.AntiAliasingMethod 4",
+        "r.Lumen.HardwareRayTracing 0", "r.Shadow.Virtual.Enable 1",
+        "r.Nanite.MaxPixelsPerEdge 1", "r.Streaming.PoolSize 3000",
+        "r.VSync 0", "t.MaxFPS 60",
+    ],
+    "high": [
+        "sg.ResolutionQuality 100", "sg.ViewDistanceQuality 3", "sg.AntiAliasingQuality 3",
+        "sg.ShadowQuality 3", "sg.GlobalIlluminationQuality 3", "sg.ReflectionQuality 3",
+        "sg.PostProcessQuality 3", "sg.TextureQuality 3", "sg.EffectsQuality 3",
+        "sg.FoliageQuality 3", "sg.ShadingQuality 3",
+        "r.ScreenPercentage 100", "r.AntiAliasingMethod 4",
+        "r.Shadow.Virtual.Enable 1", "r.Nanite.MaxPixelsPerEdge 1",
+        "r.Streaming.PoolSize 4000", "r.VSync 0", "t.MaxFPS 0",
+    ],
+}
+
+# Capture sequence for comparable measurements (run from the same spot, same preset).
+PROFILE = ["stat unit", "stat fps", "stat gpu", "stat streaming", "stat memory",
+           "stat namedevents", "memreport -full"]
+
+
+def commands(preset):
+    if preset == "profile":
+        return list(PROFILE)
+    if preset not in PRESETS:
+        raise ValueError("Unknown preset: %s (choose %s or profile)" % (preset, ", ".join(PRESETS)))
+    return list(PRESETS[preset])
+
+
+def apply(preset, ue=None):
+    """Execute in the PIE world when present, else the editor world. Runtime only."""
+    if ue is None:
+        import unreal as ue
+    subsystem = ue.get_editor_subsystem(ue.UnrealEditorSubsystem)
+    world = subsystem.get_game_world() or subsystem.get_editor_world()
+    for command in commands(preset):
+        ue.SystemLibrary.execute_console_command(world, command)
+    ue.log("Concrete Reign perf preset applied (runtime only): " + preset)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--emit", required=True, choices=sorted(PRESETS) + ["profile"])
+    args = parser.parse_args(argv)
+    print("\n".join(commands(args.emit)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/claude_tools/cs_diag_compare.py b/claude_tools/cs_diag_compare.py
