+    "state_tree": ["/Script/StateTreeModule", "StateTree"],
+    "input_mapping_context": ["/Script/EnhancedInput", "InputMappingContext"],
+    "input_action": ["/Script/EnhancedInput", "InputAction"],
+    "chaos_vehicle_wheel_class": ["/Script/ChaosVehicles", "ChaosVehicleWheel"]
+  },
+  "blueprint_parent_keywords": ["Vehicle", "Mass", "Crowd", "Traffic", "Character", "PlayerController", "GameMode", "HUD", "Interaction", "ZoneGraph", "Spawner"],
+  "thresholds": {
+    "min_samples_for_motion": 2,
+    "min_move_cm": 50.0,
+    "min_moving_fraction": 0.2,
+    "min_moving_count": 1,
+    "player_fall_dz_cm": 2000.0,
+    "streaming_count_swing_fraction": 0.5
+  }
+}
diff --git a/claude_tools/tests/fake_unreal.py b/claude_tools/tests/fake_unreal.py
new file mode 100644
index 0000000..0d1d934
--- /dev/null
+++ b/claude_tools/tests/fake_unreal.py
@@ -0,0 +1,208 @@
+"""Minimal stand-in for the Editor `unreal` module. Simulates, never proves, Editor behaviour."""
+
+
+class Vector:
+    def __init__(self, x, y, z):
+        self.x, self.y, self.z = x, y, z
+
+
+class Named:
+    def __init__(self, name, path=None):
+        self._name, self._path = name, path or name
+
+    def get_name(self):
+        return self._name
+
+    def get_path_name(self):
+        return self._path
+
+
+class ISM(Named):
+    def __init__(self, name, count):
+        super().__init__(name)
+        self.count = count
+
+    def get_instance_count(self):
+        return self.count
+
+
+class Actor(Named):
+    def __init__(self, name, cls, loc=(0, 0, 0), velocity=(0, 0, 0), isms=()):
+        super().__init__(name)
+        self.cls = Named(cls.split(".")[-1], cls)
+        self.loc = list(loc)
+        self.velocity = velocity
+        self.isms = list(isms)
+
+    def get_class(self):
+        return self.cls
+
+    def get_actor_location(self):
+        return Vector(*self.loc)
+
+    def get_components_by_class(self, _cls):
+        return self.isms
+
+    def step(self):
+        self.loc = [a + b for a, b in zip(self.loc, self.velocity)]
+
+
+class World(Named):
+    def __init__(self, path, actors, player=None):
+        super().__init__(path.split(".")[-1], path)
+        self.actors = actors
+        self.player = player
+
+
+class Asset:
+    def __init__(self, package, tags=None):
+        self.package_name = package
+        self.tags = tags or {}
+
+    def get_tag_value(self, tag):
+        return self.tags.get(tag)
+
+
+class FakeUnreal:
+    """Instance mimics module attributes used by the collector."""
+
+    class Actor:
+        pass
+
+    class InstancedStaticMeshComponent:
+        pass
+
+    class UnrealEditorSubsystem:
+        pass
+
+    def __init__(self, editor_world=None, game_world=None, assets=None, plugins=("EnhancedInput",),
+                 engine="5.4.4-0+++UE5+Release-5.4", partitioned=True):
+        self.editor_world, self.game_world = editor_world, game_world
+        self.asset_map = assets or {}
+        self.logs, self.callbacks, self.unregistered = [], {}, []
+        outer = self
+
+        class SystemLibrary:
+            commands = []
+
+            @staticmethod
+            def get_engine_version():
+                return engine
+
+            @staticmethod
+            def execute_console_command(world, command):
+                SystemLibrary.commands.append((world, command))
+
+        class GameplayStatics:
+            @staticmethod
+            def get_all_actors_of_class(world, _cls):
+                return list(world.actors)
+
+            @staticmethod
+            def get_player_pawn(world, _index):
+                return world.player
+
+        class Registry:
+            def search_all_assets(self, _sync):
+                return None
+
+            def get_assets(self, flt):
+                return list(outer.asset_map.get(flt.key, []))
+
+        class AssetRegistryHelpers:
+            @staticmethod
+            def get_asset_registry():
+                return Registry()
+
+        class WorldPartitionBlueprintLibrary:
+            @staticmethod
+            def get_actor_descs():
+                return [object()] if partitioned else []
+
+        self.SystemLibrary = SystemLibrary
+        self.GameplayStatics = GameplayStatics
+        self.AssetRegistryHelpers = AssetRegistryHelpers
+        self.WorldPartitionBlueprintLibrary = WorldPartitionBlueprintLibrary
+        if plugins is not None:
+            class PluginBlueprintLibrary:
+                @staticmethod
+                def get_enabled_plugin_names():
+                    return list(plugins)
+            self.PluginBlueprintLibrary = PluginBlueprintLibrary
+
+    def TopLevelAssetPath(self, package, name):
+        return (package, name)
+
+    def ARFilter(self, class_paths=None, class_names=None, recursive_classes=False):
+        class Filter:
+            pass
+        flt = Filter()
+        flt.key = class_paths[0][1] if class_paths else class_names[0]
+        return flt
+
+    def get_editor_subsystem(self, _cls):
+        outer = self
+
+        class Subsystem:
+            def get_editor_world(self):
+                return outer.editor_world
+
+            def get_game_world(self):
+                return outer.game_world
+        return Subsystem()
+
+    def register_slate_post_tick_callback(self, function):
+        handle = len(self.callbacks) + 1
+        self.callbacks[handle] = function
+        return handle
+
+    def unregister_slate_post_tick_callback(self, handle):
+        self.unregistered.append(handle)
+        self.callbacks.pop(handle, None)
+
+    def log(self, text):
+        self.logs.append(text)
+
+    def pump(self, seconds, step=1.0):
+        """Advance the fake Slate tick; actors move one velocity step per tick."""
+        elapsed = 0.0
+        while elapsed < seconds and self.callbacks:
+            if self.game_world:
+                for actor in self.game_world.actors + [self.game_world.player]:
+                    if actor is not None:
+                        actor.step()
+            for function in list(self.callbacks.values()):
+                function(step)
+            elapsed += step
+
+
+def city_world(traffic_velocity=(100, 0, 0), crowd_velocity=(30, 0, 0), player_z=100.0):
+    actors = [
+        Actor("BP_MassTrafficCar_C_1", "/Game/Vehicles/BP_MassTrafficCar.BP_MassTrafficCar_C", (0, 0, 0), traffic_velocity),
+        Actor("BP_MassTrafficCar_C_2", "/Game/Vehicles/BP_MassTrafficCar.BP_MassTrafficCar_C", (500, 0, 0), traffic_velocity),
+        Actor("BP_ParkedCar_C_1", "/Game/Vehicles/BP_ParkedCar.BP_ParkedCar_C", (900, 0, 0)),
+        Actor("BP_CrowdCharacter_C_1", "/Game/Crowd/BP_CrowdCharacter.BP_CrowdCharacter_C", (0, 900, 0), crowd_velocity),
+        Actor("MassVisualizer_1", "/Script/MassRepresentation.MassVisualizer", isms=[ISM("ISM_0", 240)]),
+        Actor("ZoneGraphData_1", "/Script/ZoneGraph.ZoneGraphData"),
+        Actor("MassSpawner_1", "/Script/MassSpawner.MassSpawner"),
+        Actor("StaticMeshActor_1", "/Script/Engine.StaticMeshActor"),
+    ]
+    player = Actor("BP_Player_C_0", "/Game/Player/BP_Player.BP_Player_C", (0, 0, player_z))
+    return World("/Game/Map/Small_City_LVL.Small_City_LVL", actors, player)
+
+
+ALL_PLUGINS = ("EnhancedInput", "ChaosVehiclesPlugin", "MassGameplay", "MassAI", "MassCrowd", "MassTraffic",
+               "ZoneGraph", "ZoneGraphAnnotations", "StateTree", "MassEntity")
+
+
+def city_assets():
+    return {
+        "MassEntityConfigAsset": [Asset("/Game/Mass/MEC_Crowd"), Asset("/MassTraffic/MEC_Car")],
+        "InputMappingContext": [Asset("/Game/Input/IMC_Default")],
+        "InputAction": [Asset("/Game/Input/IA_Move")],
+        "Blueprint": [
+            Asset("/Game/Vehicles/BP_Sedan", {"NativeParentClass": "/Script/CoreUObject.Class'/Script/ChaosVehicles.WheeledVehiclePawn'"}),
+            Asset("/Game/UI/BP_Unrelated", {"NativeParentClass": "/Script/CoreUObject.Class'/Script/UMG.UserWidget'"}),
+            Asset("/Engine/BP_EngineThing", {"NativeParentClass": "Vehicle"}),
+        ],
+    }
