+def run_editor(folder, ue, samples=4, interval=2.0, pump=20.0, name="report.json"):
+    output = Path(folder) / name
+    env = {"CR_DIAG_OUTPUT": str(output), "CR_DIAG_SAMPLES": str(samples), "CR_DIAG_INTERVAL": str(interval)}
+    editor.main(ue, env)
+    ue.pump(pump)
+    return json.loads(output.read_text()) if output.exists() else None
