+// Engine-independent checks for docs/claude/patches/0001 (CancelUndispatched).
+// Compiled by claude_tools/run_patch_checks.py against the PATCHED policy header only.
+#include "Core/CRVehicleHandoff.h"
+
+#include <iostream>
+#include <stdexcept>
+
+namespace
+{
+int Checks = 0;
+
+void Check(bool Condition, const char* Message)
+{
+    ++Checks;
+    if (!Condition)
+    {
+        throw std::runtime_error(Message);
+    }
+}
+
+// Defect as shipped: a rejected exit dispatch calls Fail(), the only route back is
+// ConfirmOnFootRecovery, which needs an on-foot pawn the player does not have while seated.
+void ShippedBehaviourStrandsSeatedPlayer()
+{
+    CR::FVehicleHandoff Policy;
+    Check(Policy.CompleteEnter(Policy.BeginEnter()), "enter");
+    const auto Exit = Policy.BeginExit();
+    Check(Policy.Fail(Exit), "fail rejected exit");
+    Check(Policy.GetPhase() == CR::EHandoffPhase::Recovery, "stranded in recovery");
+    Check(Policy.BeginExit() == 0, "cannot retry exit");
+    Check(Policy.BeginEnter() == 0, "cannot re-enter");
+}
+
+void CancelRestoresPriorStablePhase()
+{
+    CR::FVehicleHandoff Policy;
+    const auto Enter = Policy.BeginEnter();
+    Check(Policy.CancelUndispatched(Enter), "cancel enter");
+    Check(Policy.GetPhase() == CR::EHandoffPhase::OnFoot, "back on foot");
+    const auto Retry = Policy.BeginEnter();
+    Check(Retry > Enter, "new id after cancel");
+    Check(!Policy.CompleteEnter(Enter), "cancelled id stays stale");
+    Check(Policy.CompleteEnter(Retry), "retry completes");
+    const auto Exit = Policy.BeginExit();
+    Check(Policy.CancelUndispatched(Exit), "cancel exit");
+    Check(Policy.GetPhase() == CR::EHandoffPhase::Driving, "still driving");
+    Check(Policy.BeginExit() > Exit, "exit can be retried");
+}
+
+void CancelRejectsInvalidCalls()
+{
+    CR::FVehicleHandoff Policy;
+    Check(!Policy.CancelUndispatched(0), "zero id");
+    Check(!Policy.CancelUndispatched(1), "nothing pending");
+    const auto Enter = Policy.BeginEnter();
+    Check(!Policy.CancelUndispatched(Enter + 1), "wrong id");
+    Check(Policy.CompleteEnter(Enter), "complete");
+    Check(!Policy.CancelUndispatched(Enter), "completed request");
+    Check(Policy.GetPhase() == CR::EHandoffPhase::Driving, "unchanged");
+    Check(Policy.RequireRecovery(), "recovery");
+    Check(!Policy.CancelUndispatched(Enter), "recovery is not cancellable");
+    Check(Policy.GetPhase() == CR::EHandoffPhase::Recovery, "still recovery");
+}
+
+void RepeatedCancelCycles()
+{
+    CR::FVehicleHandoff Policy;
+    std::int32_t Last = 0;
+    for (int Index = 0; Index < 1000; ++Index)
+    {
+        const auto Id = Policy.BeginEnter();
+        Check(Id > Last, "monotonic");
+        Last = Id;
+        Check(Policy.CancelUndispatched(Id), "cycle cancel");
+        Check(Policy.GetPhase() == CR::EHandoffPhase::OnFoot, "cycle phase");
+    }
+}
+}
+
+int main()
+{
+    try
+    {
+        ShippedBehaviourStrandsSeatedPlayer();
+        CancelRestoresPriorStablePhase();
+        CancelRejectsInvalidCalls();
+        RepeatedCancelCycles();
+    }
+    catch (const std::exception& Error)
+    {
+        std::cerr << "FAILED: " << Error.what() << " after " << Checks << " checks\n";
+        return 1;
+    }
+    std::cout << "Claude handoff patch checks: " << Checks << " passed\n";
+    return 0;
+}
