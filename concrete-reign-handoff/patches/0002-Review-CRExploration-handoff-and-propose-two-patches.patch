+"""Apply docs/claude/patches/*.patch to a clean export of a commit and re-run checks.
+
+  python3 claude_tools/run_patch_checks.py            # base commit: 273b177 (Codex Phase 2)
+  python3 claude_tools/run_patch_checks.py --base HEAD
+
+Nothing in this working tree is modified: the export lives in a temporary folder.
+Checks: `git apply --check`, Codex's unittest suite, tools/validate.py, tools/run_native_tests.py,
+and claude_tools/native/test_handoff_cancel.cpp against the patched header. None of these is
+UHT, UBT or an Unreal build; the Unreal-facing parts of patch 0002 remain uncompiled.
+"""
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tarfile
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+PATCHES = sorted((ROOT / "docs/claude/patches").glob("*.patch"))
+FLAGS = ["-std=c++17", "-Wall", "-Wextra", "-Werror", "-pedantic"]
+
+
+def run(command, cwd, label, env=None):
+    print("$", label)
+    result = subprocess.run(command, cwd=cwd, capture_output=True, text=True, timeout=300,
+                            env=dict(os.environ, **(env or {})))
+    output = (result.stdout + result.stderr).strip().splitlines()
+    print("  " + ("\n  ".join(output[-3:]) if output else "(no output)"))
+    if result.returncode:
+        raise SystemExit("FAILED: " + label)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--base", default="273b177")
+    args = parser.parse_args(argv)
+    compilers = [c for c in (os.environ.get("CXX"), "g++", "clang++") if c and shutil.which(c)]
+    if not PATCHES:
+        raise SystemExit("No patches found")
+    with tempfile.TemporaryDirectory(prefix="cr-patch-") as folder:
+        archive = Path(folder) / "base.tar"
+        subprocess.run(["git", "archive", "--format=tar", "-o", str(archive), args.base], cwd=ROOT, check=True)
+        tree = Path(folder) / "tree"
+        tree.mkdir()
+        with tarfile.open(archive) as stream:
+            if hasattr(tarfile, "data_filter"):
+                stream.extractall(tree, filter="data")
+            else:
+                stream.extractall(tree)
+        for patch in PATCHES:
+            run(["git", "apply", "--check", str(patch)], tree, "apply --check " + patch.name)
+            run(["git", "apply", str(patch)], tree, "apply " + patch.name)
+        python = sys.executable
+        run([python, "-m", "unittest", "discover", "-s", "tests"], tree, "Codex unittest suite (patched tree)")
+        run([python, "tools/validate.py"], tree, "Codex repository validator (patched tree)")
+        for compiler in compilers:
+            run([python, "tools/run_native_tests.py"], tree, "Codex native policy tests with " + compiler,
+                {"CXX": compiler})
+            binary = Path(folder) / ("cancel-" + Path(compiler).name)
+            include = tree / "Plugins/CRExploration/Source/CRExploration/Public"
+            run([compiler] + FLAGS + ["-I", str(include), str(ROOT / "claude_tools/native/test_handoff_cancel.cpp"),
+                 "-o", str(binary)], tree, "compile Claude cancel test with " + compiler)
+            run([str(binary)], tree, "run Claude cancel test (" + compiler + ")")
+    print("All patch checks passed (offline policy only; Unreal build still required).")
+
+
+if __name__ == "__main__":
+    main()
